rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAgent() {
      return isSignedIn() &&
        userRole() in ['SUPPORT_AGENT', 'SUPPORT_MANAGER', 'ADMIN'];
    }

    // The owner may create/update their own profile document. Creation writes
    // the full document (id, email, role, createdAt...), so the write is not
    // field-restricted; role escalation is blocked by the update rules above
    // and by admins provisioning roles server-side only.
    function isOwnProfileWrite(ownerId) {
      return isSignedIn() && request.auth.uid == ownerId;
    }

    // ---- Users -------------------------------------------------------------
    // Profiles are readable by any signed-in user (agent directory, avatars).
    // Owners may create their document at registration and edit it later, but
    // they can never change their own email or role (no self promotion to admin).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwnProfileWrite(userId);
      allow update: if isOwnProfileWrite(userId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if false;
    }

    // ---- Tickets -----------------------------------------------------------
    match /tickets/{ticketId} {
      // Creators see their own tickets; support roles see everything.
      allow read: if isSignedIn() &&
        (resource.data.creatorId == request.auth.uid || isAgent());

      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid;

      // Status changes, assignment, and timestamp bumps.
      allow update: if isSignedIn() &&
        (resource.data.creatorId == request.auth.uid || isAgent())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedAgentId', 'assignedAgentName',
          'updatedAt', 'updatedBy', 'resolvedAt', 'closedAt'
        ]);

      allow delete: if isAgent();

      // ---- Comments --------------------------------------------------------
      // Readable by any signed-in user so cross-ticket activity feeds and
      // collectionGroup queries keep working.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.timestamp is number;
        allow update, delete: if isSignedIn() &&
          (resource.data.authorId == request.auth.uid || isAgent());
      }
    }

    // Collection-group fallback for comments queries.
    match /{path=**}/comments/{commentId} {
      allow read: if isSignedIn();
    }

    // ---- FCM device tokens -------------------------------------------------
    // Written by the Android client so Cloud Functions can deliver pushes.
    // Token docs are keyed by the token itself and carry the owner's uid.
    match /fcmTokens/{tokenId} {
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
